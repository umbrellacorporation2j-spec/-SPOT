rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function isFamilyMember(fid) {
      return signedIn()
        && exists(/databases/$(database)/documents/families/$(fid))
        && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.memberIds;
    }
    function isFamilyOwner(fid) {
      return isFamilyMember(fid)
        && get(/databases/$(database)/documents/families/$(fid)).data.ownerId == request.auth.uid;
    }

    match /users/{uid} {
      allow read, create, update: if self(uid);
      allow delete: if false;
      match /matches/{matchId} { allow read, write: if self(uid); }
    }

    // The invite code is the only public-to-authenticated lookup. The family itself is private.
    match /familyInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /families/{fid} {
      allow get: if isFamilyMember(fid);
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if isFamilyOwner(fid)
        || (signedIn()
          && request.resource.data.inviteCode == resource.data.inviteCode
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.auth.uid in request.resource.data.memberIds
          && !(request.auth.uid in resource.data.memberIds))
        || (isFamilyMember(fid)
          && request.auth.uid in resource.data.memberIds
          && !(request.auth.uid in request.resource.data.memberIds)
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
          && !(request.auth.uid in request.resource.data.members.keys()));
      allow delete: if isFamilyOwner(fid);
      match /memberPrefs/{uid} {
        allow read: if isFamilyMember(fid);
        allow create, update: if self(uid) && isFamilyMember(fid);
        allow delete: if self(uid) && isFamilyMember(fid);
      }
    }
  }
}
